{
  "name": "gchmonitoring",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/ scripts/ worker/",
    "test": "vitest run",
    "remind": "node scripts/remind.mjs",
    "watch": "node scripts/watch-games.mjs",
